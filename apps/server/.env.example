# Copy to .env and fill in. .env is git-ignored; this template is committed (keep it keyless).

# TfNSW Open Data key — https://opendata.transport.nsw.gov.au
#   My Account -> Applications -> create an app -> subscribe "Trip Planner"
#   and "Public Transport - Realtime Vehicle Positions v2" -> copy the API key here.
TFNSW_API_KEY=
TFNSW_BASE_URL=https://api.transport.nsw.gov.au

# Backend port
PORT=8787

# OpenWorkflow durable-workflow backend (Postgres). Matches docker-compose.yml.
DATABASE_URL=postgresql://waypoint:waypoint@localhost:5432/waypoint
# Stable id shared by the API and worker processes. Keep it constant.
OW_NAMESPACE_ID=00000000-0000-4000-8000-000000000001

# ntfy push alarm — choose a hard-to-guess topic and subscribe to it in the ntfy app.
NTFY_TOPIC=
NTFY_BASE_URL=https://ntfy.sh
